// Grid of nine cubes that shrink and grow in a wave, like the Electron version's spinner
export component Spinner inherits Rectangle {
    width: 40px;
    height: 40px;

    property <[float]> delays: [0.2, 0.3, 0.4, 0.1, 0.2, 0.3, 0, 0.1, 0.2];
    property <length> cell: root.width / 3;

    for delay[index] in root.delays: Rectangle {
        // Position in the 1.3 s cycle: shrink to nothing at 35 %, back to full size at 70 %
        property <float> phase: mod(animation-tick() / 1.3s - delay / 1.3 + 1, 1);
        property <float> size: phase < 0.35 ? 1 - phase / 0.35 : phase < 0.7 ? (phase - 0.35) / 0.35 : 1;

        width: root.cell * size;
        height: root.cell * size;
        x: mod(index, 3) * root.cell + (root.cell - self.width) / 2;
        y: floor(index / 3) * root.cell + (root.cell - self.height) / 2;
        background: #333333;
    }
}
