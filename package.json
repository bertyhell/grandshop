{
  "name": "grandshop",
  "version": "0.7.0",
  "description": "Photo editing software for grandparents",
  "main": "build/electron/main-interop.js",
  "scripts": {
    "start": "concurrently \"npm run electron-start\" \"npm run react-start\"",
    "build": "concurrently \"npm run electron-build\" \"npm run react-build\"",
    "electron-start": ".\\node_modules\\electron\\dist\\electron.exe . --allow-file-access-from-files",
    "node-gyp-rebuild": "node-gyp rebuild --target=9.2.0 --arch=x64 --dist-url=https://electronjs.org/headers",
    "electron-rebuild": "npx electron-rebuild",
    "electron-build": "concurrently \"npm:electron-build-main\" \"npm:electron-build-shared\"",
    "electron-build-main": "babel src/electron --out-dir build/electron --extensions .ts --source-maps inline",
    "electron-build-shared": "babel src/shared --out-dir build/shared --extensions .ts,.tsx --source-maps inline && cp src/shared/translations/*.json build/shared/translations",
    "electron-check-types": "tsc -p tsconfig-electron.json --noEmit",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "prepack": "rimraf build electron-dist && npm run react-build && npm run electron-build",
    "predist": "npm run prepack",
    "pack": "electron-builder --dir -c.extraMetadata.main=build/electron/main.js",
    "dist": "electron-builder -c.extraMetadata.main=build/electron/main.js",
    "lint": "tslint -p .",
    "format": "npm run lint -- --fix",
    "fetch-translations-from-poeditor": "dotenv -e .env fetch-poeditor ./src/shared/translations/poeditor",
    "build-extract-translations-script": "tsc --sourceMap --esModuleInterop --resolveJsonModule scripts/extract-and-replace-translations.ts",
    "extract-translations": "npm run fetch-translations-from-poeditor && npm run build-extract-translations-script && node scripts/extract-and-replace-translations.js && npm run format"
  },
  "dependencies": {
    "@babel/runtime": "^7.11.2",
    "@fortawesome/fontawesome-free": "^5.12.0",
    "@jaames/iro": "^4.5.3",
    "@jcoreio/async-throttle": "^1.1.2",
    "@use-it/event-listener": "^0.1.3",
    "classnames": "^2.2.6",
    "color": "^3.1.2",
    "electron-is-dev": "^1.2.0",
    "electron-reload": "^1.5.0",
    "fs-extra": "^8.1.0",
    "i18next": "^19.1.0",
    "iso-639-1": "^2.1.0",
    "lodash-es": "^4.17.15",
    "pretty-bytes": "^5.3.0",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-i18next": "^11.3.2",
    "react-range": "^1.4.6",
    "react-redux": "^7.1.3",
    "react-scripts": "^3.4.3",
    "react-select": "^3.0.8",
    "react-textarea-autosize": "^7.1.2",
    "react-toastify": "^5.4.1",
    "react-use-mouse-move": "^1.0.4",
    "redux": "^4.0.4",
    "redux-devtools-extension": "^2.13.8",
    "redux-thunk": "^2.3.0",
    "resizable-panels-react": "git+https://github.com/bertyhell/ResizablePanelsReact.git#master",
    "sharp": "^0.25.4",
    "text-to-svg": "^3.1.5",
    "use-debounce": "^3.3.0",
    "use-previous": "^1.0.0",
    "uuid": "^3.3.3",
    "viewerjs": "^1.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.5",
    "@babel/core": "^7.11.1",
    "@babel/plugin-proposal-numeric-separator": "^7.10.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.11.0",
    "@babel/plugin-transform-modules-commonjs": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.11.0",
    "@babel/preset-env": "^7.11.0",
    "@babel/preset-typescript": "^7.10.4",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.4.0",
    "@testing-library/user-event": "^7.2.1",
    "@types/classnames": "^2.2.9",
    "@types/color": "^3.0.1",
    "@types/fs-extra": "^8.0.1",
    "@types/jest": "^24.0.24",
    "@types/lodash": "^4.14.149",
    "@types/lodash-es": "^4.17.3",
    "@types/node": "^12.12.21",
    "@types/react": "^16.9.17",
    "@types/react-dom": "^16.9.4",
    "@types/react-redux": "^7.1.5",
    "@types/react-select": "^3.0.8",
    "@types/react-textarea-autosize": "^4.3.5",
    "@types/react-toastify": "^4.1.0",
    "@types/sharp": "^0.25.1",
    "@types/uuid": "^3.4.6",
    "concurrently": "^5.0.2",
    "copyfiles": "^2.1.1",
    "cross-env": "^6.0.3",
    "dotenv": "^8.2.0",
    "dotenv-cli": "^3.1.0",
    "electron": "^9.2.0",
    "electron-builder": "^22.8.0",
    "electron-prebuilt": "^1.4.13",
    "fetch-poeditor": "^0.5.2",
    "node-sass": "^4.13.0",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.0",
    "sort-object-keys": "^1.1.3",
    "tslint": "^5.20.1",
    "tslint-config-airbnb": "^5.11.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1",
    "typescript": "^3.8.2",
    "webpack": "^4.42.0"
  },
  "keywords": [
    "photoshop",
    "easy",
    "graphicmagick",
    "grandparents",
    "image",
    "manipulation",
    "graphics"
  ],
  "build": {
    "appId": "com.electron.grandshop",
    "productName": "grandshop",
    "extends": null,
    "directories": {
      "buildResources": "electron-build",
      "output": "electron-dist"
    },
    "files": [
      "node_modules/**/*",
      "build/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.graphics-design"
    }
  },
  "author": {
    "name": "Bert Verhelst",
    "email": "verhelstbert@gmail.com"
  },
  "contributors": [
    {
      "name": "Laurens Hellinger"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/bertyhell/grandshop/issues"
  },
  "homepage": "./",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
