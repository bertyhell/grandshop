{
  "name": "grandshop",
  "version": "0.12.0",
  "description": "Photo editing software for grandparents",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node src/scripts/copy-tensorflow-dll.mjs",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "electron-builder-install-deps": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config electron-builder.json5",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.json5",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.json5",
    "fetch-translations-from-poeditor": "dotenv -e .env fetch-poeditor ./src/shared/translations/poeditor",
    "extract-translations": "tsx src/scripts/extract-and-replace-translations.ts && npm run format",
    "fetch-and-extract-translations": "npm run fetch-translations-from-poeditor && npm run extract-translations"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@jaames/iro": "5.5.2",
    "@jcoreio/async-throttle": "1.7.0",
    "@reduxjs/toolkit": "2.13.0",
    "@tensorflow/tfjs-node": "4.22.0",
    "@upscalerjs/esrgan-thick": "1.0.0",
    "@vingle/bmp-js": "0.2.5",
    "allotment": "1.20.6",
    "clsx": "2.1.1",
    "fs-extra": "11.4.1",
    "i18next": "26.5.10",
    "iso-639-1": "3.1.6",
    "lodash-es": "4.18.1",
    "pretty-bytes": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-range": "1.10.0",
    "react-redux": "9.3.0",
    "react-select": "5.10.2",
    "react-textarea-autosize": "8.5.9",
    "react-toastify": "11.1.0",
    "sharp": "0.35.5",
    "text-to-svg": "3.1.5",
    "upscaler": "1.0.0",
    "viewerjs": "1.15.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "4.0.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@eslint/js": "9.39.5",
    "@types/fs-extra": "11.0.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv-cli": "11.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fetch-poeditor": "0.5.2",
    "glob": "13.0.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "keywords": [
    "photoshop",
    "easy",
    "graphicmagick",
    "grandparents",
    "image",
    "manipulation",
    "graphics"
  ],
  "author": {
    "name": "Bert Verhelst",
    "email": "verhelstbert@gmail.com"
  },
  "contributors": [
    {
      "name": "Laurens Hellinger"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/bertyhell/grandshop/issues"
  },
  "homepage": "./",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
