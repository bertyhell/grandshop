{
  "name": "grandshop",
  "version": "0.6.0",
  "description": "Photoshop for your grandparents",
  "main": "build/electron/main.js",
  "scripts": {
    "electron-start": "src/electron . --allow-file-access-from-files",
    "electron-rebuild": "npx electron-rebuild -v 7.1.11",
    "electron-build": "concurrently \"npm:electron-build-main\" \"npm:electron-build-shared\"",
    "electron-build-main": "babel src/electron --out-dir build/electron --extensions .ts --source-maps inline",
    "electron-build-shared": "babel src/shared/modifications --out-dir build/shared/modifications --extensions .ts,.tsx --source-maps inline",
    "electron-check-types": "tsc -p tsconfig-electron.json --noEmit",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "prepack": "rimraf build electron-dist && npm run react-build && npm run electron-build",
    "predist": "npm run prepack",
    "pack": "electron-builder --dir -c.extraMetadata.main=build/electron/main.js",
    "dist": "electron-builder -c.extraMetadata.main=build/electron/main.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.7.7",
    "@fortawesome/fontawesome-free": "^5.12.0",
    "@jaames/iro": "^4.5.3",
    "@jcoreio/async-throttle": "^1.1.2",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.4.0",
    "@testing-library/user-event": "^7.2.1",
    "@types/jest": "^24.0.24",
    "@types/node": "^12.12.21",
    "@types/react": "^16.9.17",
    "@types/react-dom": "^16.9.4",
    "blend-promise-utils": "^1.24.1",
    "classnames": "^2.2.6",
    "electron": "^7.1.11",
    "electron-is-dev": "^1.1.0",
    "electron-reload": "^1.5.0",
    "fs-extra": "^8.1.0",
    "gm": "^1.23.1",
    "lodash-es": "^4.17.15",
    "node-sass": "^4.13.0",
    "pretty-bytes": "^5.3.0",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-range": "^1.4.6",
    "react-redux": "^7.1.3",
    "react-scripts": "3.3.0",
    "react-select": "^3.0.8",
    "react-textarea-autosize": "^7.1.2",
    "react-toastify": "^5.4.1",
    "redux": "^4.0.4",
    "redux-devtools-extension": "^2.13.8",
    "redux-thunk": "^2.3.0",
    "resizable-panels-react": "git+https://github.com/bertyhell/ResizablePanelsReact.git#master",
    "sharp": "^0.24.0",
    "typescript": "^3.7.4",
    "use-debounce": "^3.3.0",
    "use-previous": "^1.0.0",
    "uuid": "^3.3.3",
    "viewerjs": "^1.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.7.7",
    "@babel/core": "^7.7.7",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-proposal-numeric-separator": "^7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.7.7",
    "@babel/plugin-transform-modules-commonjs": "^7.7.5",
    "@babel/plugin-transform-runtime": "^7.7.6",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-typescript": "^7.7.7",
    "@types/classnames": "^2.2.9",
    "@types/fs-extra": "^8.0.1",
    "@types/gm": "^1.18.6",
    "@types/lodash": "^4.14.149",
    "@types/lodash-es": "^4.17.3",
    "@types/react-redux": "^7.1.5",
    "@types/react-select": "^3.0.8",
    "@types/react-textarea-autosize": "^4.3.5",
    "@types/react-toastify": "^4.1.0",
    "@types/sharp": "^0.24.0",
    "@types/uuid": "^3.4.6",
    "concurrently": "^5.0.2",
    "copyfiles": "^2.1.1",
    "cross-env": "^6.0.3",
    "electron-builder": "^22.3.2",
    "electron-prebuilt": "^1.4.13",
    "rimraf": "^3.0.0",
    "tslint": "^5.20.1",
    "tslint-config-airbnb": "^5.11.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1",
    "typescript": "^3.7.5"
  },
  "keywords": [
    "photoshop",
    "easy",
    "graphicmagick",
    "grandparents",
    "image",
    "manipulation",
    "graphics"
  ],
  "build": {
    "appId": "com.electron.grandshop",
    "productName": "grandshop",
    "extends": null,
    "directories": {
      "buildResources": "electron-build",
      "output": "electron-dist"
    },
    "files": [
      "node_modules/**/*",
      "build/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.graphics-design"
    }
  },
  "author": {
    "name": "Bert Verhelst",
    "email": "verhelstbert@gmail.com"
  },
  "contributors": [
    {
      "name": "Laurens Hellinger"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/bertyhell/grandshop/issues"
  },
  "homepage": "./",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
