{
  "name": "grandshop",
  "version": "0.1.0",
  "description": "Photoshop for your grandparents",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .  --allow-file-access-from-files",
    "compile": "tsc -w -p tsconfig-electron.json",
    "client-start": "react-scripts start",
    "client-build": "react-scripts build",
    "client-test": "react-scripts test",
    "client-eject": "react-scripts eject",
    "--prepack": "npm run client-build",
    "pack": "copyfiles electron/**/*.js build && electron-builder --dir -c.extraMetadata.main=electron/main.js",
    "dist": "electron-builder -c.extraMetadata.main=electron/main.js"
  },
  "dependencies": {
    "@jaames/iro": "^4.5.3",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.4.0",
    "@testing-library/user-event": "^7.2.1",
    "@types/jest": "^24.0.24",
    "@types/node": "^12.12.21",
    "@types/react": "^16.9.17",
    "@types/react-dom": "^16.9.4",
    "classnames": "^2.2.6",
    "electron-is-dev": "^1.1.0",
    "fs-extra": "^8.1.0",
    "gm": "^1.23.1",
    "lodash-es": "^4.17.15",
    "node-sass": "^4.13.0",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-redux": "^7.1.3",
    "react-scripts": "3.3.0",
    "react-select": "^3.0.8",
    "redux": "^4.0.4",
    "redux-devtools-extension": "^2.13.8",
    "redux-thunk": "^2.3.0",
    "resizable-panels-react": "^2.0.8",
    "typescript": "^3.7.4",
    "use-debounce": "^3.3.0",
    "use-previous": "^1.0.0",
    "electron-reload": "^1.5.0",
    "uuid": "^3.3.3",
    "react-range": "^1.4.6"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.9",
    "@types/fs-extra": "^8.0.1",
    "@types/gm": "^1.18.6",
    "@types/lodash": "^4.14.149",
    "@types/lodash-es": "^4.17.3",
    "@types/react-redux": "^7.1.5",
    "@types/react-select": "^3.0.8",
    "@types/uuid": "^3.4.6",
    "copyfiles": "^2.1.1",
    "electron": "7.1.7",
    "electron-builder": "^21.2.0",
    "tslint": "^5.20.1",
    "tslint-config-airbnb": "^5.11.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1",
    "typescript": "^3.7.4"
  },
  "keywords": [
    "photoshop",
    "easy",
    "graphicmagick",
    "grandparents",
    "image",
    "manipulation",
    "graphics"
  ],
  "build": {
    "appId": "com.electron.grandshop",
    "productName": "Grandshop",
    "extends": null,
    "directories": {
      "buildResources": "electron-build",
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "build/**/*",
      "lib/**/*",
      "public/**/*",
      "electron/**/*.js"
    ],
    "win": {
      "target": "dir"
    },
    "mac": {
      "category": "public.app-category.graphics-design"
    }
  },
  "author": {
    "name": "Bert Verhelst",
    "email": "verhelstbert@gmail.com"
  },
  "contributors": [
    {
      "name": "Laurens Hellinger"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/bertyhell/grandshop/issues"
  },
  "homepage": "./",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
