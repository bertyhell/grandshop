// Colours taken from the SCSS of the Electron version
export global Theme {
    out property <color> preview-background: #888888;
    out property <color> sidebar-background: #eeeeee;
    out property <color> splitter-background: #e0e0e0;
    out property <color> splitter-grip: #666666;
    out property <color> primary: #223b82;
    out property <color> primary-border: #182347;
    out property <color> secondary: #eaeaea;
    out property <color> secondary-border: #acacac;
    out property <color> text: #333333;
    out property <color> placeholder: #808080;
    out property <color> card-border: #aaaaaa;
    out property <color> input-border: #aaaaaa;
    out property <color> focus: #2684ff;
    out property <color> range-filled: #149cb8; // hsl(190, 80%, 40%)
    out property <color> range-empty: #c4c4c4;
    out property <color> crop-shade: #000000a0;
    out property <color> crop-frame: #ffffff;
    out property <color> crop-grid: #ffffff66;
    out property <color> crop-handle-shadow: #00000080;
}

export enum ModKind { add-border, add-image-border, brightness, sepia, resize, annotate, crop, rotate, mirror, greyscale, upscale, improve-faces }

// Union of the parameters of every modification kind; each kind uses a few of them.
// Pixel values are in original-image pixels. Border thickness, border width and font size
// are percentages of the shorter side.
export struct ModParams {
    thickness: float,
    color: color,
    border-index: int,
    border-width: float,
    factor: float,
    contrast: float,
    size: float,
    text: string,
    font-size: float,
    x-percent: float,
    y-percent: float,
    top: float,
    right: float,
    bottom: float,
    left: float,
    text-color: color,
    angle: float,
    background: color,
    mirror-horizontal: bool,
    mirror-vertical: bool,
    // Crop card adds `top`/`right`/`bottom`/`left` pixels of `background` instead
    enlarge: bool,
    upscale-factor: float,
    // Enlarge card uses the large, slow network
    best-quality: bool,
    // Sepia, black and white, and "Improve faces" (how much of the restored face), in percent
    strength: float,
    saturation: float,
    // Rotate card cuts off the corners instead of filling them with `background`
    rotate-fill: bool,
    // Text card: 0 none, 1 outline, 2 shadow
    text-effect: int,
    // Crop card: fixed shape, 0 free, then square, 4:3, 3:2, 16:9
    aspect-index: int,
}

// Numeric parameters that a slider can change
export enum ModField {
    thickness, border-width, factor, contrast, size, font-size, x-percent, y-percent, top, right,
    bottom, left, angle, upscale-factor, strength,
    saturation,
}

// Colours that a colour picker can change
export enum ColorField { color, text-color, background }

// On/off parameters
export enum FlagField { mirror-horizontal, mirror-vertical, enlarge, best-quality, rotate-fill }

export struct ModEntry {
    kind: ModKind,
    // "Border 2": how many of this kind existed when it was added, plus one
    number: int,
    open: bool,
    params: ModParams,
}

export enum ToastKind { info, success, warning, error }

export struct Toast { id: int, kind: ToastKind, message: string }

export struct ImageSize { width: int, height: int }

// Hue in degrees, saturation and value from 0 to 1
export struct Hsv { hue: float, saturation: float, value: float }

// State and actions shared between the UI and the Rust controller
export global AppState {
    in property <image> preview-image;
    in property <bool> has-image: false;
    in property <bool> has-modified-image: false;
    // Size of the current result at full resolution
    in property <int> image-width;
    in property <int> image-height;

    in property <bool> loading: false;
    in property <bool> rendering: false;
    in property <bool> saving: false;
    out property <bool> busy: loading || rendering || saving;
    // Fraction done of a long (AI) modification in the current render; -1 when there is none
    in property <float> render-progress: -1;

    // The card list, and the full resolution size of the image that goes into each card
    in property <[ModEntry]> modifications;
    in property <[ImageSize]> input-sizes;
    in property <[string]> border-styles;
    // Small example of each border style, for the style picker
    in property <[image]> border-thumbnails;
    // Estimated size of the saved PNG, for the "Reduce image" card
    in property <string> estimated-file-size;
    in property <image> color-wheel;
    // The AI model for "Enlarge image" is being downloaded, and the fraction done
    in property <bool> upscaler-downloading: false;
    in property <float> upscaler-download-progress: 0;
    // The AI models for "Improve faces" are being downloaded, and the fraction done
    in property <bool> faces-downloading: false;
    in property <float> faces-download-progress: 0;
    // Longest side an enlarged image may get
    in property <int> upscale-max-edge;
    // Clicking the preview picks a colour for the open cards with a colour picker
    in property <bool> eyedropper-active: false;

    // Sharp full resolution tile over part of the preview when zoomed in. The position is
    // in fractions of the shown image.
    in property <image> detail-image;
    in property <bool> detail-visible: false;
    in property <float> detail-left;
    in property <float> detail-top;
    in property <float> detail-right;
    in property <float> detail-bottom;

    // Frame of the crop card being edited, in fractions of the shown image. While it is
    // shown, the preview shows the image going into that card. When enlarging, the frame
    // lies outside the image and the space between is filled with `crop-background`.
    in property <bool> crop-active: false;
    in property <bool> crop-enlarge: false;
    in property <color> crop-background;
    in property <float> crop-left;
    in property <float> crop-top;
    in property <float> crop-right;
    in property <float> crop-bottom;

    // First line of the text card being edited, in fractions of the shown image. While it
    // is shown, the preview stops after that card, so later cards don't move the text away.
    in property <bool> text-active: false;
    in property <float> text-x;
    in property <float> text-y;

    // Notifications in the bottom left corner, oldest first
    in property <[Toast]> toasts;

    callback add-modification(ModKind);
    callback toggle-modification(int);
    callback delete-modification(int);
    callback set-number(int, ModField, float);
    callback set-color(int, ColorField, color);
    callback set-flag(int, FlagField, bool);
    callback set-text(int, string);
    callback set-border-style(int, int);
    callback set-text-effect(int, int);
    callback set-aspect(int, int);
    callback invalid-number();
    // Position in the shown image, from 0 to 1 on both axes
    callback preview-clicked(float, float);
    // A crop frame handle was dragged: the new frame in fractions of the shown image
    callback crop-dragged(float, float, float, float);
    // The text grip was dragged: the new position in fractions of the shown image
    callback text-dragged(float, float);
    // Viewer: rotate and flip are view-only and never saved
    callback rotate-left();
    callback rotate-right();
    callback flip-horizontal();
    callback flip-vertical();
    callback reset-view();
    // Visible part of the shown image (fractions) and its size on screen in logical pixels
    callback view-changed(float, float, float, float, float, float);
    pure callback hsv-to-color(Hsv) -> color;
    pure callback color-to-hsv(color) -> Hsv;

    // Settings dialog
    in-out property <bool> settings-open: false;
    in property <[string]> languages;
    in property <int> language-index: 0;
    // Run the AI models on the graphics card
    in property <bool> use-gpu: true;
    // Space taken by the downloaded AI models, e.g. "75 MB"
    in property <string> ai-models-size;
    // Language index and whether to use the graphics card
    callback save-settings(int, bool);
    callback delete-ai-models();

    callback open-image();
    callback save-image();
}

// Texts shown by the Rust side (notifications, file dialogs), so they use the same translations
export global Strings {
    out property <string> open-failed: @tr("Failed to open the image");
    out property <string> saved: @tr("Image has been saved");
    out property <string> save-failed: @tr("Saving the image failed");
    out property <string> apply-failed: @tr("Applying the last operation failed");
    out property <string> invalid-number: @tr("The value must be a valid number");
    out property <string> open-dialog-title: @tr("Select the image that you want to edit");
    out property <string> save-dialog-title: @tr("Choose the location and name to save your image");
    out property <string> pictures: @tr("Pictures");
    out property <string> all-files: @tr("All files");
    out property <string> upscaler-downloading: @tr("Downloading the enlarging tool (2 MB)…");
    out property <string> upscaler-best-downloading: @tr("Downloading the best quality enlarging tool (140 MB)…");
    out property <string> upscaler-ready: @tr("The enlarging tool is ready");
    out property <string> faces-downloading: @tr("Downloading the face tool (345 MB)…");
    out property <string> faces-ready: @tr("The face tool is ready");
    out property <string> faces-failed: @tr("Downloading the face tool failed. Check the internet connection and add the operation again.");
    out property <string> upscaler-failed: @tr("Downloading the enlarging tool failed. Check the internet connection and add the operation again.");
}
