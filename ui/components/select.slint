import { Theme } from "../globals.slint";

// Dropdown with a placeholder, styled like react-select in the Electron version
export component Select inherits Rectangle {
    in property <[string]> options;
    // Optional picture for each option, shown before its text
    in property <[image]> icons;
    // -1 shows the placeholder
    in property <int> current-index: -1;
    in property <string> placeholder;

    callback selected(index: int);

    property <bool> has-value: root.current-index >= 0 && root.current-index < root.options.length;
    property <bool> has-icons: root.icons.length > 0;
    property <length> icon-width: 64px;
    property <length> icon-height: 48px;

    height: root.has-icons ? 60px : 38px;
    background: white;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover || focus.has-focus ? Theme.focus : Theme.input-border;

    accessible-role: combobox;
    accessible-value: root.has-value ? root.options[root.current-index] : root.placeholder;
    accessible-action-default => { popup.show(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return || event.text == Key.DownArrow) {
                popup.show();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            popup.show();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        if root.has-icons && root.has-value: Image {
            source: root.icons[root.current-index];
            width: root.icon-width;
            height: root.icon-height;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }

        Text {
            text: root.has-value ? root.options[root.current-index] : root.placeholder;
            color: root.has-value ? Theme.text : Theme.placeholder;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 1px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            background: #cccccc;
        }

        // Chevron
        Path {
            width: 12px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            commands: "M 1 1 L 6 6 L 11 1";
            viewbox-width: 12;
            viewbox-height: 7;
            stroke: Theme.placeholder;
            stroke-width: 2px;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;

        Rectangle {
            background: white;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.input-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000033;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;

                for option[index] in root.options: Rectangle {
                    height: root.has-icons ? 60px : 38px;
                    background: index == root.current-index ? #2684ff : option-touch.has-hover ? #deebff : transparent;

                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(index); }
                    }

                    if root.has-icons: Image {
                        x: 12px;
                        y: (parent.height - self.height) / 2;
                        width: root.icon-width;
                        height: root.icon-height;
                        source: root.icons[index];
                        image-fit: contain;
                    }

                    Text {
                        x: root.has-icons ? 12px + root.icon-width + 10px : 12px;
                        width: parent.width - self.x - 12px;
                        height: parent.height;
                        text: option;
                        font-size: 14px;
                        color: index == root.current-index ? white : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
