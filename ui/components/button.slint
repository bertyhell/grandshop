import { Theme } from "../globals.slint";

export enum ButtonKind { primary, secondary }

export component Button inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;

    callback clicked();

    property <color> base: kind == ButtonKind.primary ? Theme.primary : Theme.secondary;
    property <color> foreground: kind == ButtonKind.primary ? white : Theme.text;

    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: kind == ButtonKind.primary ? Theme.primary-border : Theme.secondary-border;
    background: !enabled ? base.transparentize(50%) : touch.pressed ? base.brighter(30%) : touch.has-hover ? base.brighter(20%) : base;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 12px;
        padding-right: 12px;

        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.foreground;
            width: 20px;
            height: 20px;
            image-fit: contain;
            y: (parent.height - self.height) / 2;
        }

        if root.label != "": Text {
            text: root.label.to-uppercase();
            color: root.foreground;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
