import { AppState, ImageSize, ModEntry, ModKind, Theme } from "../globals.slint";
import { Button, ButtonKind } from "button.slint";
import {
    AddBorderControls, AddImageBorderControls, AnnotateControls, BrightnessControls,
    ColouriseControls, CropControls, ImproveFacesControls, MirrorControls, RemoveBackgroundControls, RemoveObjectsControls, ResizeControls, RotateControls,
    StrengthControls,
    UpscaleControls,
} from "../modifications/panels.slint";

// Collapsible card for one modification in the stack
export component ModificationCard inherits Rectangle {
    in property <ModEntry> entry;
    in property <int> index;
    in property <ImageSize> input-size;

    property <string> title:
        entry.kind == ModKind.add-border ? @tr("Border {}", entry.number)
        : entry.kind == ModKind.add-image-border ? @tr("Image border {}", entry.number)
        : entry.kind == ModKind.brightness ? @tr("Brightness and contrast {}", entry.number)
        : entry.kind == ModKind.sepia ? @tr("Sepia {}", entry.number)
        : entry.kind == ModKind.resize ? @tr("Shrink {}", entry.number)
        : entry.kind == ModKind.annotate ? @tr("Caption {}", entry.number)
        : entry.kind == ModKind.crop ? @tr("Crop {}", entry.number)
        : entry.kind == ModKind.rotate ? @tr("Rotate {}", entry.number)
        : entry.kind == ModKind.mirror ? @tr("Mirror {}", entry.number)
        : entry.kind == ModKind.upscale ? @tr("Enlarge {}", entry.number)
        : entry.kind == ModKind.improve-faces ? @tr("Improve faces {}", entry.number)
        : entry.kind == ModKind.remove-background ? @tr("Remove background {}", entry.number)
        : entry.kind == ModKind.colourise ? @tr("Colour {}", entry.number)
        : entry.kind == ModKind.remove-objects ? @tr("Remove objects {}", entry.number)
        : @tr("Black and White {}", entry.number);

    background: white;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        Rectangle {
            height: 42px;

            TouchArea {
                mouse-cursor: pointer;
                clicked => { AppState.toggle-modification(root.index); }
            }

            HorizontalLayout {
                padding-left: 10px;
                spacing: 10px;

                Text {
                    text: root.title;
                    color: black;
                    font-size: 15px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }

                Button {
                    label: @tr("Delete");
                    kind: ButtonKind.secondary;
                    height: parent.height;
                    clicked => { AppState.delete-modification(root.index); }
                }
            }
        }

        if root.entry.open: Rectangle {
            height: 1px;
            background: Theme.card-border;
        }

        if root.entry.open && root.entry.kind == ModKind.add-border: AddBorderControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.add-image-border: AddImageBorderControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.brightness: BrightnessControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && (root.entry.kind == ModKind.sepia || root.entry.kind == ModKind.greyscale): StrengthControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.resize: ResizeControls {
            index: root.index;
            params: root.entry.params;
            input-size: root.input-size;
        }
        if root.entry.open && root.entry.kind == ModKind.annotate: AnnotateControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.crop: CropControls {
            index: root.index;
            params: root.entry.params;
            input-size: root.input-size;
        }
        if root.entry.open && root.entry.kind == ModKind.rotate: RotateControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.mirror: MirrorControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.upscale: UpscaleControls {
            index: root.index;
            params: root.entry.params;
            input-size: root.input-size;
        }
        if root.entry.open && root.entry.kind == ModKind.improve-faces: ImproveFacesControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.remove-background: RemoveBackgroundControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.colourise: ColouriseControls {
            index: root.index;
            params: root.entry.params;
        }
        if root.entry.open && root.entry.kind == ModKind.remove-objects: RemoveObjectsControls {
            index: root.index;
            params: root.entry.params;
        }
    }
}
