// Controls for each modification kind. Every change is sent to Rust, which updates the card
// and re-renders the preview.

import { Switch, TextEdit } from "std-widgets.slint";
import { AppState, ColorField, FlagField, ImageSize, ModField, ModParams, Theme } from "../globals.slint";
import { FormField } from "../components/form-field.slint";
import { RangeInput } from "../components/range-input.slint";
import { ColorInput } from "../components/color-input.slint";
import { Select } from "../components/select.slint";
import { Button, ButtonKind } from "../components/button.slint";

component Panel inherits VerticalLayout {
    padding: 10px;
}

export component AddBorderControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;

    FormField {
        label: @tr("Thickness (%)");
        RangeInput {
            minimum: 0;
            maximum: 25;
            step: 0.1;
            value: root.params.thickness;
            edited(value) => { AppState.set-number(root.index, ModField.thickness, value); }
        }
    }

    FormField {
        label: @tr("Color");
        ColorInput {
            value: root.params.color;
            edited(value) => { AppState.set-color(root.index, ColorField.color, value); }
        }
    }
}

export component AddImageBorderControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;

    FormField {
        label: @tr("Border style");
        Select {
            options: AppState.border-styles;
            icons: AppState.border-thumbnails;
            current-index: root.params.border-index;
            selected(style) => { AppState.set-border-style(root.index, style); }
        }
    }

    FormField {
        label: @tr("Border width (%)");
        RangeInput {
            minimum: 1;
            maximum: 25;
            step: 0.1;
            value: root.params.border-width;
            edited(value) => { AppState.set-number(root.index, ModField.border-width, value); }
        }
    }
}

export component BrightnessControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;

    FormField {
        label: @tr("Brightness");
        RangeInput {
            minimum: 0;
            maximum: 2;
            step: 0.01;
            value: root.params.factor;
            edited(value) => { AppState.set-number(root.index, ModField.factor, value); }
        }
    }

    FormField {
        label: @tr("Contrast");
        RangeInput {
            minimum: 0;
            maximum: 2;
            step: 0.01;
            value: root.params.contrast;
            edited(value) => { AppState.set-number(root.index, ModField.contrast, value); }
        }
    }

    FormField {
        label: @tr("Color intensity");
        RangeInput {
            minimum: 0;
            maximum: 2;
            step: 0.01;
            value: root.params.saturation;
            edited(value) => { AppState.set-number(root.index, ModField.saturation, value); }
        }
    }
}

// Sepia and black and white
export component StrengthControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;

    FormField {
        label: @tr("Strength (%)");
        RangeInput {
            minimum: 0;
            maximum: 100;
            value: root.params.strength;
            edited(value) => { AppState.set-number(root.index, ModField.strength, value); }
        }
    }
}

export component ResizeControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    in property <ImageSize> input-size;

    FormField {
        label: @tr("Maximum size in pixels");
        RangeInput {
            minimum: 10;
            maximum: min(max(root.input-size.width, root.input-size.height), 10000);
            value: root.params.size;
            edited(value) => { AppState.set-number(root.index, ModField.size, value); }
        }
    }

    Text {
        text: @tr("Resulting filesize") + ": " + AppState.estimated-file-size;
        color: Theme.text;
        font-size: 14px;
    }
}

export component AnnotateControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;

    FormField {
        label: @tr("Text");
        TextEdit {
            height: 80px;
            placeholder-text: @tr("Type your text here");
            init => { self.text = root.params.text; }
            edited(text) => { AppState.set-text(root.index, text); }
        }
    }

    FormField {
        label: @tr("Text size (%)");
        RangeInput {
            minimum: 0.5;
            maximum: 30;
            step: 0.1;
            value: root.params.font-size;
            edited(value) => { AppState.set-number(root.index, ModField.font-size, value); }
        }
    }

    FormField {
        label: @tr("Horizontal position");
        RangeInput {
            minimum: 0;
            maximum: 100;
            step: 0.01;
            value: root.params.x-percent;
            edited(value) => { AppState.set-number(root.index, ModField.x-percent, value); }
        }
    }

    FormField {
        label: @tr("Vertical position");
        RangeInput {
            minimum: 0;
            maximum: 100;
            step: 0.01;
            value: root.params.y-percent;
            edited(value) => { AppState.set-number(root.index, ModField.y-percent, value); }
        }
    }

    FormField {
        label: @tr("Text color");
        ColorInput {
            value: root.params.text-color;
            edited(value) => { AppState.set-color(root.index, ColorField.text-color, value); }
        }
    }

    FormField {
        label: @tr("Make the text stand out");
        Select {
            options: [@tr("No"), @tr("Outline"), @tr("Shadow")];
            current-index: root.params.text-effect;
            selected(effect) => { AppState.set-text-effect(root.index, effect); }
        }
    }
}

export component CropControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    in property <ImageSize> input-size;
    spacing: 10px;

    Switch {
        text: @tr("Enlarge instead of crop");
        checked: root.params.enlarge;
        toggled => { AppState.set-flag(root.index, FlagField.enlarge, self.checked); }
    }

    if !root.params.enlarge: FormField {
        label: @tr("Shape");
        Select {
            options: [@tr("Free"), @tr("Square"), "4:3", "3:2", "16:9"];
            current-index: root.params.aspect-index;
            selected(preset) => { AppState.set-aspect(root.index, preset); }
        }
    }

    FormField {
        label: @tr("Top");
        RangeInput {
            maximum: root.input-size.height;
            value: root.params.top;
            edited(value) => { AppState.set-number(root.index, ModField.top, value); }
        }
    }

    FormField {
        label: @tr("Turn left");
        RangeInput {
            maximum: root.input-size.width;
            value: root.params.left;
            edited(value) => { AppState.set-number(root.index, ModField.left, value); }
        }
    }

    FormField {
        label: @tr("Turn right");
        RangeInput {
            maximum: root.input-size.width;
            value: root.params.right;
            edited(value) => { AppState.set-number(root.index, ModField.right, value); }
        }
    }

    FormField {
        label: @tr("Bottom");
        RangeInput {
            maximum: root.input-size.height;
            value: root.params.bottom;
            edited(value) => { AppState.set-number(root.index, ModField.bottom, value); }
        }
    }

    if root.params.enlarge: FormField {
        label: @tr("Background color");
        ColorInput {
            value: root.params.background;
            edited(value) => { AppState.set-color(root.index, ColorField.background, value); }
        }
    }
}

export component RotateControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    spacing: 10px;

    // Turns by `degrees` from the current angle, keeping it between -180 and 180
    function turn(degrees: float) {
        AppState.set-number(root.index, ModField.angle, 180 - mod(180 - root.params.angle - degrees, 360));
    }

    HorizontalLayout {
        spacing: 10px;

        Button {
            icon: @image-url("../icons/undo.svg");
            label: @tr("Turn left");
            kind: ButtonKind.secondary;
            horizontal-stretch: 1;
            clicked => { root.turn(-90); }
        }
        Button {
            icon: @image-url("../icons/redo.svg");
            label: @tr("Turn right");
            kind: ButtonKind.secondary;
            horizontal-stretch: 1;
            clicked => { root.turn(90); }
        }
    }

    FormField {
        label: @tr("Angle");
        RangeInput {
            minimum: -180;
            maximum: 180;
            step: 0.01;
            value: root.params.angle;
            edited(value) => { AppState.set-number(root.index, ModField.angle, value); }
        }
    }

    Switch {
        text: @tr("Cut off the corners");
        checked: root.params.rotate-fill;
        toggled => { AppState.set-flag(root.index, FlagField.rotate-fill, self.checked); }
    }

    if !root.params.rotate-fill: FormField {
        label: @tr("Background color");
        ColorInput {
            value: root.params.background;
            edited(value) => { AppState.set-color(root.index, ColorField.background, value); }
        }
    }
}

export component MirrorControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    spacing: 10px;

    Switch {
        text: @tr("Mirror horizontally");
        checked: root.params.mirror-horizontal;
        toggled => { AppState.set-flag(root.index, FlagField.mirror-horizontal, self.checked); }
    }

    Switch {
        text: @tr("Mirror vertically");
        checked: root.params.mirror-vertical;
        toggled => { AppState.set-flag(root.index, FlagField.mirror-vertical, self.checked); }
    }
}

export component UpscaleControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    in property <ImageSize> input-size;
    property <int> longest: max(root.input-size.width, root.input-size.height, 1);
    property <bool> too-large: root.longest * root.params.upscale-factor > AppState.upscale-max-edge;
    spacing: 10px;

    FormField {
        label: @tr("Enlarge times");
        RangeInput {
            minimum: 2;
            maximum: 4;
            value: root.params.upscale-factor;
            edited(value) => { AppState.set-number(root.index, ModField.upscale-factor, value); }
        }
    }

    Switch {
        text: @tr("Best quality (much slower)");
        checked: root.params.best-quality;
        toggled => { AppState.set-flag(root.index, FlagField.best-quality, self.checked); }
    }

    Text {
        text: @tr("New size: {} × {} pixels", root.input-size.width * root.params.upscale-factor,
            root.input-size.height * root.params.upscale-factor);
        color: Theme.text;
        font-size: 14px;
    }

    if root.too-large: Text {
        text: @tr("This is too large. Shrink the image first or enlarge fewer times.");
        color: #b00020;
        font-size: 14px;
        wrap: word-wrap;
    }

    if AppState.upscaler-downloading: Text {
        text: @tr("Downloading the enlarging tool… {}%", Math.round(AppState.upscaler-download-progress * 100));
        color: Theme.text;
        font-size: 14px;
        wrap: word-wrap;
    }

    Text {
        text: root.params.best-quality
            ? @tr("Best quality can take several minutes, even for small images.")
            : @tr("Enlarging uses artificial intelligence and can take a minute for large images.");
        color: Theme.placeholder;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component ImproveFacesControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    spacing: 10px;

    FormField {
        label: @tr("Strength (%)");
        RangeInput {
            minimum: 0;
            maximum: 100;
            value: root.params.strength;
            edited(value) => { AppState.set-number(root.index, ModField.strength, value); }
        }
    }

    if AppState.faces-downloading: Text {
        text: @tr("Downloading the face tool… {}%", Math.round(AppState.faces-download-progress * 100));
        color: Theme.text;
        font-size: 14px;
        wrap: word-wrap;
    }

    Text {
        text: @tr("Finds the faces in the photo and makes them sharper with artificial intelligence. Takes about a second per face.");
        color: Theme.placeholder;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component RemoveBackgroundControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    spacing: 10px;

    Switch {
        text: @tr("Fill the background with a colour");
        checked: root.params.fill-background;
        toggled => { AppState.set-flag(root.index, FlagField.fill-background, self.checked); }
    }

    if root.params.fill-background: FormField {
        label: @tr("Background color");
        ColorInput {
            value: root.params.background;
            edited(value) => { AppState.set-color(root.index, ColorField.background, value); }
        }
    }

    if AppState.background-downloading: Text {
        text: @tr("Downloading the background tool… {}%", Math.round(AppState.background-download-progress * 100));
        color: Theme.text;
        font-size: 14px;
        wrap: word-wrap;
    }

    Text {
        text: root.params.fill-background
            ? @tr("Finds the people or things in front with artificial intelligence and fills everything behind them.")
            : @tr("Finds the people or things in front with artificial intelligence and makes everything behind them see-through. Save as PNG to keep it see-through.");
        color: Theme.placeholder;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component ColouriseControls inherits Panel {
    in property <int> index;
    in property <ModParams> params;
    spacing: 10px;

    FormField {
        label: @tr("Colour strength (%)");
        RangeInput {
            minimum: 0;
            maximum: 100;
            value: root.params.strength;
            edited(value) => { AppState.set-number(root.index, ModField.strength, value); }
        }
    }

    if AppState.colourise-downloading: Text {
        text: @tr("Downloading the colouring tool… {}%", Math.round(AppState.colourise-download-progress * 100));
        color: Theme.text;
        font-size: 14px;
        wrap: word-wrap;
    }

    Text {
        text: @tr("Artificial intelligence guesses the colours of a black and white photo. The colours are a guess, not the real ones.");
        color: Theme.placeholder;
        font-size: 13px;
        wrap: word-wrap;
    }
}
